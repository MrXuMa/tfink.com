---
import "@fontsource/jetbrains-mono/400.css";
import "@fontsource/jetbrains-mono/500.css";
import "@fontsource/jetbrains-mono/700.css";
import "@fontsource/maple-mono/400.css";
import "@fontsource/maple-mono/500.css";
import "@fontsource/maple-mono/700.css";
import "../style.css";
import { LINKS } from "../lib/constants";
import { SITE } from "../site-config";

interface Props {
  title: string;
  description: string;
  page?: "blog";
  slug?: string | undefined;
  pubDate?: string;
}

const { title, description, page, pubDate } = Astro.props;
const siteOrigin = new URL(SITE.site.url).origin;
const pageUrl = page === "blog" && Astro.props.slug
  ? new URL(Astro.props.slug, SITE.site.url).href
  : Astro.url.href;
const image = `${siteOrigin}/og-image.png`;

const schema =
  page !== "blog"
    ? {
        "@context": "https://schema.org",
        "@type": "Person",
        name: SITE.author.fullName,
        url: siteOrigin,
        sameAs: [LINKS.linkedin, LINKS.github],
        image,
        jobTitle: SITE.author.jobTitle,
        knowsAbout: [
          "Cybersecurity",
          "SOAR",
          "Google Chronicle",
          "Detection Engineering",
          "CTFs",
          "Elastic Security",
          "Python",
        ],
        worksFor: {
          "@type": "Organization",
          name: "Cyflare",
          address: {
            "@type": "PostalAddress",
            addressLocality: SITE.location.countryName,
            addressCountry: SITE.location.countryCode,
          },
        },
        alumniOf: {
          "@type": "CollegeOrUniversity",
          name: "Florida State University",
        },
        nationality: {
          "@type": "Country",
          name: SITE.location.countryName,
        },
      }
    : {
        "@context": "https://schema.org",
        "@type": "BlogPosting",
        mainEntityOfPage: {
          "@type": "WebPage",
          "@id": pageUrl,
        },
        headline: title,
        description: description || title,
        image,
        author: {
          "@type": "Person",
          name: SITE.author.shortName,
          url: siteOrigin,
          sameAs: [LINKS.linkedin, LINKS.github],
        },
        publisher: {
          "@type": "Organization",
          name: SITE.author.shortName,
          logo: {
            "@type": "ImageObject",
            url: image,
          },
        },
        datePublished: pubDate || new Date().toISOString(),
        dateModified: pubDate || new Date().toISOString(),
      };

// Prevent `</script>` breakout in JSON-LD
const schemaJson = JSON.stringify(schema).replace(/</g, "\\u003c");
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta content="width=device-width" name="viewport" />
    <link href="/favicon.svg" rel="icon" type="image/svg+xml" />
    <link href="/favicon.ico" rel="icon" sizes="any" />
    <meta content={Astro.generator} name="generator" />
    <title>{title}</title>
    <meta content={description} name="description" />
    <meta content="index, follow" name="robots" />
    <meta name="theme-color" content="#3b82f6" />
    <meta name="author" content={SITE.author.fullName} />
    <meta
      name="keywords"
      content={`cybersecurity, SOAR, detection engineering, CTF, Elastic Security, Florida State University, ${SITE.author.fullName}`}
    />
    <meta content="website" property="og:type" />
    <meta content={title} property="og:title" />
    <meta content={description} property="og:description" />
    <meta content={pageUrl} property="og:url" />
    <meta property="og:site_name" content={SITE.author.fullName} />
    <meta property="og:locale" content="en_US" />
    <meta content={image} property="og:image" />
    <meta property="og:image:alt" content={description} />
    <meta property="og:image:type" content="image/png" />
    <meta content="summary_large_image" name="twitter:card" />
    <meta content={title} name="twitter:title" />
    <meta content={description} name="twitter:description" />
    <meta content={image} name="twitter:image" />

    <link href={pageUrl} rel="canonical" />
    <script is:inline set:html={schemaJson} type="application/ld+json" />
  </head>
  <body class="bg-darkslate-700 flex flex-col justify-center items-center">
    <slot name="loader" />
    <slot />
  </body>
</html>

<style is:global>
  body {
    margin: 0;
    font-family: var(--font-jetbrains-mono), "JetBrains Mono", monospace;
    -webkit-font-smoothing: antialiased;
    line-height: 1.65;
  }

  h1,
  h2,
  h3,
  h4,
  h5,
  h6 {
    font-family: var(--font-maple-mono), "Maple Mono", monospace;
    line-height: 1.35;
  }
  p {
    font-family: var(--font-jetbrains-mono), "JetBrains Mono", monospace;
    line-height: 1.7;
  }

  b {
    font-weight: 700 !important;
  }
</style>
