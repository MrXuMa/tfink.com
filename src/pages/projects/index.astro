---
import { Icon } from "astro-icon/components";
import Layout from "../../layouts/Layout.astro";
import { SITE } from "../../site-config";
import { projects, statusLabel } from "../../data/projects";
---

<script>
  import { animate, type AnimationSequence } from "motion";
  import { loaderAnimation } from "../../lib/constants";

  const loader = document.querySelector(".loader");
  animate([loaderAnimation] as AnimationSequence).finished.finally(() => {
    loader?.remove();
  });
</script>

<Layout
  description={`Projects by ${SITE.author.fullName} — homelab SIEM, malware research, and SOAR engineering.`}
  title={`${SITE.author.fullName} - Projects`}
>
  <main
    class="w-full min-h-screen flex flex-col justify-start items-stretch max-w-3xl mx-auto p-8 text-neutral-100"
  >
    <a
      class="text-white bg-neutral-900 hover:bg-neutral-800 px-4 py-2 mb-8 border border-solid border-neutral-600 rounded-lg w-fit"
      href="/">Back</a
    >
    <h1 class="text-4xl font-bold mb-2 text-neutral-100">Projects</h1>
    <p class="text-sm text-darkslate-300 mb-8 m-0 font-light">
      Labs, research, and security engineering work
    </p>

    <ul class="w-full flex flex-col gap-4 list-none p-0 m-0">
      {
        projects.map((project) => (
          <li class="border border-darkslate-400 rounded-lg bg-darkslate-500 p-5 hover:border-primary-500 transition-colors">
            <div class="flex items-start justify-between gap-3 mb-2">
              <h2 class="text-xl font-bold m-0">
                {project.href ? (
                  <a href={project.href} class="no-underline text-inherit hover:text-primary-300">
                    {project.title}
                  </a>
                ) : (
                  project.title
                )}
              </h2>
              <span class="text-[11px] shrink-0 px-2 py-1 rounded-full border border-darkslate-400 text-darkslate-200">
                {statusLabel(project.status)}
              </span>
            </div>
            <p class="text-sm font-light text-darkslate-200 m-0 mb-3 leading-relaxed">
              {project.summary}
            </p>
            <div class="flex flex-wrap items-center justify-between gap-3">
              <ul class="flex flex-wrap gap-2 list-none p-0 m-0">
                {project.tags.map((tag) => (
                  <li class="text-[11px] px-2 py-1 rounded-full border border-darkslate-400 bg-darkslate-600 text-darkslate-100">
                    {tag}
                  </li>
                ))}
              </ul>
              {project.repo && (
                <a
                  href={project.repo}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-1.5 text-sm text-darkslate-100 hover:text-primary-300 no-underline shrink-0"
                >
                  <Icon name="ri:github-fill" class="text-base" />
                  GitHub
                </a>
              )}
            </div>
          </li>
        ))
      }
    </ul>
  </main>
</Layout>
