---
interface Props {
  title?: string;
  body?: string;
}

const { title, body } = Astro.props;
---

<div class="flex flex-col gap-3 h-full min-h-0">
  {title && <h2 class="text-xl font-bold m-0 z-20 shrink-0">{title}</h2>}
  {body && <p class="m-0 font-light text-base shrink-0">{body}</p>}
  <slot />
</div>
